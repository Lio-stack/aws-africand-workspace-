# Modèle de variables d'environnement : noms uniquement, aucune valeur réelle.
# Copier en .env.local (non versionné) et renseigner localement.

# Supabase (local : valeurs affichées par `npx supabase status`)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé serveur uniquement : jamais exposée au client ni préfixée NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
